[Unit]
Description=CEA 活动平台后端 (FastAPI)
Documentation=https://github.com/cea/event-hub
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=cea
Group=cea
WorkingDirectory=/srv/cea/backend

# ---------------------------------------------------------------------------
# 启动方式：`python -m app`（见 backend/app/__main__.py）
#
# 用它而不是 `uvicorn app.main:app --host … --port …`，是因为监听地址要放到
# `.env` 里：uvicorn 的 --host/--port 是 CLI 参数，而它的 UVICORN_* 环境变量只从
# **进程环境**取值、不读 .env —— 写进 .env 会被静默忽略，服务照旧听 8000。
#
# 三个硬约束（--workers 1 / --proxy-headers / --forwarded-allow-ips）**刻意写死在
# 那个入口里**，不从 .env 取：它们各自对应一条防线，做成可配置等于把绕过去的开关
# 交出去。理由见 docs/deployment.md 的「启动参数不是可选项」。
#
#   --workers 1
#       应用层限流是进程内内存实现。多进程会让每个进程各持一份计数，
#       实际阈值被放大到 N 倍。SQLite 的写入本来就串行化在单写者锁上，
#       多进程只会增加锁争用而不提升写入吞吐，因此单进程与存储模型也一致。
#
#   proxy_headers / forwarded_allow_ips
#       只信任 nginx 写入的转发头。不配置的话，客户端自己发一个
#       X-Forwarded-For 就能把限流键算到伪造地址上，应用层限流形同虚设。
#       forwarded_allow_ips 由 TRUSTED_PROXY_IPS 推导，两者不再需要人工同步。
#
# 监听地址请在 .env 里设 API_HOST / API_PORT（生产建议保持 127.0.0.1）。
# ---------------------------------------------------------------------------
ExecStart=/srv/cea/.venv/bin/python -m app

# 环境变量从 .env 读取（该文件不入库，含 IP_HASH_SALT 等密钥）
EnvironmentFile=/srv/cea/backend/.env
Environment=APP_ENV=production

Restart=on-failure
RestartSec=3

# 优雅停机：给正在进行的上传留出时间
TimeoutStopSec=30
KillSignal=SIGTERM

# ---------------------------------------------------------------------------
# 加固
# ---------------------------------------------------------------------------
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true

# 只有内容与数据目录需要可写
ReadWritePaths=/srv/cea/content /srv/cea/data /srv/cea/var

# 日志交给 journald，不额外写文件（日志轮转由 journald 负责）
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
