# 统一换行符，避免 Windows/Linux 协作时整文件 diff
* text=auto

*.py    text eol=lf
*.ts    text eol=lf
*.vue   text eol=lf
*.js    text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.html  text eol=lf
*.css   text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.toml  text eol=lf
*.ini   text eol=lf
*.cfg   text eol=lf
*.sh    text eol=lf

*.ps1   text eol=crlf
*.bat   text eol=crlf
*.cmd   text eol=crlf

# 二进制，不做换行转换
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.pdf   binary
*.zip   binary
*.woff  binary
*.woff2 binary

# 构建产物不参与语言统计
dist/**      linguist-generated
*.lock       linguist-generated
package-lock.json linguist-generated
