# 统一换行符，避免 Windows/Linux 协作时整文件 diff
* text=auto

# 点文件没有扩展名，落不到下面任何一条规则上，于是每次 add 都会警告
# "LF will be replaced by CRLF"。它们同样是文本，同样该是 LF
.env*   text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

*.py    text eol=lf
*.ts    text eol=lf
*.vue   text eol=lf
*.js    text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.html  text eol=lf
*.css   text eol=lf
# 邮件的纯文本正文也是模板（app/templates/email/*.txt），一并归一
*.txt   text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.toml  text eol=lf
*.ini   text eol=lf
*.cfg   text eol=lf
*.sh    text eol=lf

*.ps1   text eol=crlf
*.bat   text eol=crlf
*.cmd   text eol=crlf

# 二进制，不做换行转换
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.pdf   binary
*.zip   binary
*.woff  binary
*.woff2 binary

# 构建产物不参与语言统计
dist/**      linguist-generated
*.lock       linguist-generated
package-lock.json linguist-generated
*.conf  text eol=lf
