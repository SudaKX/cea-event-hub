# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ---- Node ----
node_modules/

# SDK 构建产物：由 npm run build:sdk 产出到 public/ 下，供开发时静态提供，
# 并随构建复制进 dist/。构建产物不入库。
frontend/public/sdk/

# ---- 后端环境变量（含密钥，绝不入库）----
backend/.env
backend/.env.*
!backend/.env.example

# ---- 运行时数据：活动内容与上传文件不进版本控制 ----
/content/*
!/content/.gitkeep
/data/*
!/data/.gitkeep
/var/*
!/var/.gitkeep

# ---- 数据库文件 ----
*.db
*.db-journal
*.sqlite3
*.sqlite3-journal

# ---- 编辑器与系统 ----
.DS_Store
Thumbs.db
*.swp
