# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ---- Node ----
node_modules/

# SDK 构建产物：由 npm run build:sdk 产出到 public/ 下，供开发时静态提供，
# 并随构建复制进 dist/。构建产物不入库。
frontend/public/sdk/

# ---- 参考资料：第三方文档、接入护栏，供查阅而不入库 ----
# 它们是别人的东西，会随时间与上游漂移；放进仓库等于替上游维护一份必然过期的
# 副本。与 var/ 同理：留在工作区，不进版本控制。
/.ref/*
!/.ref/.gitkeep

# ---- 后端环境变量（含密钥，绝不入库）----
backend/.env
backend/.env.*
!backend/.env.example

# ---- 运行时数据：活动内容与上传文件不进版本控制 ----
/content/*
!/content/.gitkeep
/data/*
!/data/.gitkeep
/var/*
!/var/.gitkeep

# ---- 数据库文件 ----
*.db
*.db-journal
*.sqlite3
*.sqlite3-journal

# ---- 活动页构建产物 ----
# 由 events/<活动>/npm run build 产出（混淆后的页面与投放 zip）。
# 源码在 events/ 下入库，产物不入库 —— 与 frontend/public/sdk/ 同一条理由。
/events/*/dist/

# ---- 编辑器与系统 ----
.DS_Store
Thumbs.db
*.swp
