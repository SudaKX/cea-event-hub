# 复制为 backend/.env 后按需修改。backend/.env 已被 git 忽略，不会入库。
# 列表类型（如 TRUSTED_PROXY_IPS）使用 JSON 语法。
# 空值（KEY=）对可空的数值项表示"不限额"。

# ---------- 基础 ----------
APP_ENV=development
API_PREFIX=/api/v1
PUBLIC_BASE_URL=http://localhost:5173
APP_ORIGIN=http://localhost:5173

# ---------- 数据库 ----------
# 默认落在 var/app.db；换库时改这一行即可
# DATABASE_URL=sqlite+pysqlite:///D:/Ds_Projects/FullStack/cea-event-hub/var/app.db

# ---------- 会话 ----------
SESSION_TTL_SECONDS=604800
SESSION_COOKIE_NAME=cea_sid
# 开发走 http 时必须为 false，否则浏览器不会回传 Cookie
SESSION_COOKIE_SECURE=false

# ---------- 安全 ----------
# 生产环境必须显式设置，否则应用拒绝启动：
# 未加盐的 IPv4 哈希可在数秒内暴力反查，等于明文存储客户端地址
# IP_HASH_SALT=replace-with-a-long-random-secret

# ---------- 提交体积与数量 ----------
MAX_PAYLOAD_BYTES=65536
MAX_UPLOAD_BYTES=20971520
MAX_FILES_PER_REQUEST=10
MAX_REQUEST_BYTES=67108864
# 留空表示该类别不限额
MAX_SUBMISSIONS_PER_EVENT_ANON=4096
# MAX_SUBMISSIONS_PER_EVENT_AUTHED=
MAX_EVENT_STORAGE_BYTES=536870912
# 注：曾经有 DEDUP_WINDOW_SECONDS（按内容哈希去重的窗口），已随该机制一并移除。
# 现在只有 Idempotency-Key 一条幂等路径，见 docs/submission-contract.md。

# ---------- 内容包投放 ----------
MAX_CONTENT_ARCHIVE_BYTES=33554432
MAX_CONTENT_ENTRIES=2000
MAX_CONTENT_EXTRACTED_BYTES=209715200

# ---------- 活动页的桥接脚本注入 ----------
# 返回 HTML 时自动补一行 <script src="/sdk/v1/cea.js" id="cea-sdk">，
# 使活动页作者不必记得写。幂等：页面自己引用了就不再注入。
# 设为 false 回到"必须显式引用"的行为。
CONTENT_SDK_INJECT=true
CONTENT_SDK_PATH=/sdk/v1/cea.js

# ---------- 限流 ----------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_SUBMIT_IP_MAX=30
RATE_LIMIT_SUBMIT_IP_WINDOW=60
RATE_LIMIT_SUBMIT_USER_MAX=20
RATE_LIMIT_SUBMIT_USER_WINDOW=60
RATE_LIMIT_AUTH_IP_MAX=10
RATE_LIMIT_AUTH_IP_WINDOW=60
# 只有这些来源写入的转发头才被采信；其余请求的 X-Forwarded-For 一律忽略
TRUSTED_PROXY_IPS=["127.0.0.1", "::1"]

# ---------- 邮件 ----------
# console：把邮件写进日志（开发默认）| smtp：自建邮局 | resend：Resend HTTP API
EMAIL_BACKEND=console
# EMAIL_BACKEND=smtp
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_STARTTLS=true
# EMAIL_BACKEND=resend
# 选 resend 时填上密钥。留空不阻止启动，但每次发信都会失败并记进日志 ——
# 注册会走到"请查收邮件"却没有邮件，所以日志里那句要看。
# 密钥只放这里（.env 已被 git 忽略），不要写进代码或提交进仓库。
# RESEND_API_KEY=
# 发件地址必须落在 Resend 里**已验证的域名**下。它提供的 onboarding@resend.dev
# 只用于试发，拿它当生产发件人会被拒。
EMAIL_FROM=noreply@example.com

# ---------- 注册待验证占位 ----------
# 占位锁着用户名与邮箱，所以是分钟级而不是小时级
PENDING_REGISTRATION_TTL_SECONDS=600

# ---------- 找回与验证开关（默认全关，等邮件接上再逐一打开）----------
REQUIRE_EMAIL_VERIFICATION=false
ALLOW_SELF_SERVICE_RESET=false

# ---------- 首次启动引导管理员 ----------
ADMIN_BOOTSTRAP_ENABLED=true
ADMIN_USERNAME=admin
# 留空：生成随机口令并只在创建那一次输出；设置后启动输出中不出现口令
# ADMIN_INITIAL_PASSWORD=

# ---------- 后台清理 ----------
JANITOR_ENABLED=true
JANITOR_INTERVAL_SECONDS=300
PENDING_FILE_TTL_SECONDS=3600
